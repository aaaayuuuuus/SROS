# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to version control.

# ── Flask ─────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# ── Database ──────────────────────────────────────────────────────────────
# For development (SQLite):
DATABASE_URL=sqlite:///sros_dev.db
# For production (PostgreSQL on Railway / Render):
# DATABASE_URL=postgresql://user:password@host:5432/sros

# ── Redis ─────────────────────────────────────────────────────────────────
# Leave blank to use in-memory fallback (dev/testing)
REDIS_URL=redis://localhost:6379/0

# ── OpenRouteService ─────────────────────────────────────────────────────
# Get a FREE key at: https://openrouteservice.org/dev/#/signup
# Free tier: 2,000 geocode requests/day, 500 route requests/day
ORS_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
